{
  "_comment": "Layout de menús horneados (baked). Fuente de verdad para el plugin y el resource pack. Cada elemento debe colocarse en el slot exacto indicado para que los catchers coincidan con los iconos pintados en el PNG de fondo.",
  "grid": {
    "columns": 9,
    "rows": 6,
    "slot_formula": "slot = row * 9 + col",
    "slot_xy": "x = 8 + 18*col,  y = 26 + 18*row",
    "block_size": "2x2 = 4 cuadrantes (tl, tr, bl, br), ancla en esquina superior-izquierda",
    "item_size": "1x1 = 16x16 px, centrado en slot con +1px padding"
  },

  "menus": {
    "bg_menu_ward_status": {
      "theme": "default",
      "separator_row": 2,
      "description": "Ward status (Synt/acero). Eje central = C4. U y T en R0-R1, C centrado en C4, profile + permisos en R4.",
      "visual_grid": [
        "R0: _ U U _ _ _ T T _",
        "R1: _ U U _ _ _ T T _",
        "R2: ─────────────────",
        "R3: _ _ _ C C _ _ _ _",
        "R4: _ P R _ _ _ I c _",
        "R5: (libre)"
      ],
      "elements": [
        { "key": "icon.upkeep",         "type": "block", "slot": 1,  "row": 0, "col": 1, "note": "upkeep 2x2, ocupa C1-C2 R0-R1" },
        { "key": "icon.ward.tier",      "type": "block", "slot": 6,  "row": 0, "col": 6, "note": "tier/fase 2x2, ocupa C6-C7 R0-R1" },
        { "key": "icon.city.overview",  "type": "block", "slot": 30, "row": 3, "col": 3, "note": "score base centrado en C4, ocupa C3-C4 R3-R4" },
        { "key": "menu.profile",        "type": "item",  "slot": 37, "row": 4, "col": 1, "note": "identidad jugador" },
        { "key": "menu.roles",          "type": "item",  "slot": 38, "row": 4, "col": 2, "note": "permisos" },
        { "key": "icon.ward.inactive",  "type": "item",  "slot": 42, "row": 4, "col": 6, "note": "eliminar nucleus" },
        { "key": "menu.close",          "type": "item",  "slot": 43, "row": 4, "col": 7, "note": "cerrar" }
      ]
    },

    "bg_menu_city_overview": {
      "theme": "matriz",
      "separator_row": 3,
