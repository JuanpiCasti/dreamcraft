    "bg_menu_estate_instance": {
      "theme": "nexo",
      "separator_row": 3,
      "description": "Estate instance (Nexo/violeta). Vista simplificada con back, inactive y close.",
      "visual_grid": [
        "R0: _ _ _ _ _ _ _ P _",
        "R1: I I _ E E _ B B _",
        "R2: I I _ E E _ B B _",
